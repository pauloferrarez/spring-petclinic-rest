{
  "info": {
    "name": "P2 - Grupo - PetClinic REST",
    "description": "Testes de integração/API do grupo P2 (Testes e Qualidade de Software). Cada requisição indica o caso de teste (CT) e o requisito (RF/RNF) relacionados. Requer o back-end em execução e a variável baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verificações aplicadas a todas as requisições (RNF-01 e RNF-03)",
          "pm.test(\"RNF-03: nenhuma resposta 500 (erro interno)\", () => pm.expect(pm.response.code).to.be.below(500));",
          "pm.test(\"RNF-03: resposta não expõe stack trace\", () => {",
          "    const texto = pm.response.text();",
          "    pm.expect(texto).to.not.match(/\\tat [a-z]+\\.|\\.java:\\d+\\)/);",
          "});",
          "pm.test(\"RNF-01: tempo de resposta abaixo de \" + pm.environment.get(\"limiteMs\") + \" ms\", () =>",
          "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"limiteMs\") || 500)));"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "API-01 - Ciclo de vida do dono (RF-01, CT-003)",
      "item": [
        {
          "name": "CT-003a Criar dono válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"TesteApi\",\n  \"address\": \"Rua A, 100\",\n  \"city\": \"Bauru\",\n  \"telephone\": \"1432345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const dono = pm.response.json();",
                  "pm.test(\"Retorna id numérico\", () => pm.expect(dono.id).to.be.a(\"number\"));",
                  "pm.test(\"Dados retornados iguais aos enviados\", () => {",
                  "    const enviado = JSON.parse(pm.request.body.raw);",
                  "    Object.keys(enviado).forEach(k => pm.expect(dono[k]).to.eql(enviado[k]));",
                  "});",
                  "pm.collectionVariables.set(\"ownerId\", dono.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-003b Consultar dono criado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const dono = pm.response.json();",
                  "pm.test(\"Contrato básico: campos e tipos\", () => {",
                  "    pm.expect(dono).to.include.keys(\"id\", \"firstName\", \"lastName\", \"address\", \"city\", \"telephone\", \"pets\");",
                  "    pm.expect(dono.pets).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Mesmo dono criado\", () => pm.expect(dono.id).to.eql(Number(pm.collectionVariables.get(\"ownerId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Limpeza: excluir dono criado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owners/{{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Exclusão bem-sucedida (2xx)\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-003c Dono excluído não é mais encontrado",
          "request": {
