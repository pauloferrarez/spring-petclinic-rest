      "item": [
        {
          "name": "Preparação: criar dono (petOwnerId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"TestePet\",\n  \"address\": \"Rua A, 100\",\n  \"city\": \"Bauru\",\n  \"telephone\": \"1432345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"petOwnerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-022 Nascimento hoje (limite válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/owners/{{petOwnerId}}/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{petOwnerId}}",
                "pets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rex\",\n  \"birthDate\": \"{{hoje}}\",\n  \"type\": {\n    \"id\": 2,\n    \"name\": \"dog\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => d.toISOString().slice(0, 10);",
                  "const hoje = new Date(); hoje.setHours(12, 0, 0, 0);",
                  "const dias = (n) => { const d = new Date(hoje); d.setDate(d.getDate() + n); return fmt(d); };",
                  "const anos = (n) => { const d = new Date(hoje); d.setFullYear(d.getFullYear() + n); return d; };",
                  "pm.collectionVariables.set(\"hoje\", fmt(hoje));",
                  "pm.collectionVariables.set(\"amanha\", dias(1));",
                  "pm.collectionVariables.set(\"ha50anos\", fmt(anos(-50)));",
                  "const d = anos(-50); d.setDate(d.getDate() - 1);",
                  "pm.collectionVariables.set(\"ha50anosMais1dia\", fmt(d));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"petId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-023 Nascimento amanhã (futuro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
