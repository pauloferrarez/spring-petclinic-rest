              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensagem de idade máxima\", () => pm.expect(pm.response.text()).to.include(\"Birth date cannot be older than 50 years\"));"
                ]
              }
            }
